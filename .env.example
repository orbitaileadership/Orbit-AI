# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → Data API (URL, without /rest/v1/) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Who can sign up: any email by default (students picking a listed school must use that school's email).
# SCHOOL_EMAILS_ONLY=on limits it to university/college emails (~10,000 schools built in, plus *.edu / *.ac.xx);
# ALLOWED_EMAIL_DOMAINS then adds more domains (comma-separated).
SCHOOL_EMAILS_ONLY=off
ALLOWED_EMAIL_DOMAINS=
# Whole schools that skip the waitlist, e.g. "uwo.ca,utoronto.ca" (their subdomains too).
EARLY_ACCESS_DOMAINS=
# Waitlist: "on" (default) sends new accounts to /waitlist. "off" lets every verified account in.
WAITLIST_MODE=on
# Comma-separated emails that skip the waitlist (team and testers).
EARLY_ACCESS_EMAILS=nteitleb@uwo.ca

# Server-only Supabase secret key (Project Settings → API Keys → Secret key). Used for budgets and image uploads.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# "on" = real model calls with budget checks. Anything else = demo replies, no cost.
LIVE_MODELS=off
# Provider API keys (server only). A missing key shows "isn't set up yet" for that app.
OPENAI_API_KEY=
# Claude: ANTHROPIC_API_KEY or CLAUDE_API_KEY both work.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Web search ("Search the web" in the + menu). Get a key at tavily.com. Without it, searching is turned off.
TAVILY_API_KEY=

# Spoken replies (voice conversations and "Listen"). Optional: with an ElevenLabs key, replies use ElevenLabs voices;
# without it they use OpenAI's voices (OPENAI_API_KEY); with neither, the browser's own voices.
ELEVENLABS_API_KEY=
# Optional default voice id (ElevenLabs → Voices → "ID"). Students can pick another in voice mode.
ELEVENLABS_VOICE_ID=

# Staff-only analytics page (/admin/analytics). Exact verified emails, comma separated, empty = no access.
ANALYTICS_ADMIN_EMAILS=
# Feedback inbox email alerts use Resend. Recipients are the analytics admin addresses above.
# Verify the From address/domain in Resend before setting it; never expose the API key client-side.
RESEND_API_KEY=
FEEDBACK_NOTIFICATION_FROM=
# Optional pgvector retrieval. Requires migration 0010, OpenAI key, and the student's memory opt-in.
SMART_MEMORY_ENABLED=off

# Integrations (+ menu → "Add from apps"). See docs/INTEGRATIONS.md. Apps without keys show as "not set up".
# GitHub, Zotero and YouTube need no keys (public repos; students paste their own Zotero key; Gemini watches videos).
# Google Drive — Google Cloud console: enable "Google Picker API" + "Google Drive API"; OAuth consent screen with the
# drive.file scope; an OAuth client (Web) with your site as an authorized JavaScript origin; an API key restricted to
# the Picker API and your site. APP_ID is the project number.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# OneDrive — Microsoft Entra admin center → App registrations → New (accounts in any org + personal Microsoft accounts),
# platform "Single-page application" with redirect URI https://<your site>/auth/microsoft (and http://localhost:3000/auth/microsoft),
# API permission Microsoft Graph → delegated → Files.Read (+ Mail.Read, Calendars.Read for Outlook mail/calendar).
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# Gmail / Google Calendar / Drive plugins use NEXT_PUBLIC_GOOGLE_CLIENT_ID. Google Auth Platform → Data access → add scopes:
#   read: gmail.readonly, calendar.readonly, drive.readonly
#   write (each change is confirmed by the student first): gmail.send, gmail.compose, gmail.modify, calendar.events, drive, drive.file
# and enable the Gmail, Google Calendar, Google Drive, Google Docs and Google Sheets APIs.
# GitHub "Connect" button (public repos work without this) — your GitHub App (github.com/settings/apps):
#   Callback URL + Setup URL: https://<your site>/auth/github (add http://localhost:3000/auth/github too), tick "Redirect on update";
#   Repository permissions: Contents, Metadata, Issues, Pull requests = Read-only; no webhook.
#   Client ID, a client secret (Generate a new client secret) and the app's URL name (github.com/apps/<slug>):
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Notion — notion.so/profile/integrations → New integration → Public; capabilities: Read content only;
# redirect URI https://<your site>/auth/notion (and http://localhost:3000/auth/notion). The secret stays server-side.
NEXT_PUBLIC_NOTION_CLIENT_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Research plugins (Wikipedia, arXiv, Semantic Scholar, Crossref) need no keys. Optional, for higher limits:
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
# Wolfram|Alpha plugin (exact maths/science): free App ID at developer.wolframalpha.com (LLM API). Server-only.
WOLFRAM_APP_ID=

# Public footer: supply owner-approved values before launch (otherwise shows pending notices).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=

# Confirm the account contract rate before enabling Wolfram; integer USD micros per LLM request.
WOLFRAM_REQUEST_USD_MICROS=
# Paid evaluations require an existing, dedicated tester enrollment and budget. Never use a student account.
EVAL_ACCOUNTING_USER_ID=
# Per-run sum of conservative reservation bounds; the account's atomic budget also applies across runs.
EVAL_MAX_COST_USD_MICROS=
